////         3914. Minimum Operations to Make Array Non Decreasing          ////



class Solution {
    public int minOperations(int[] nums) {
        long totalSum = 0; 
        
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] <= nums[i - 1]) {
                int target = nums[i - 1] + 1;
                totalSum += (target - nums[i]);
                nums[i] = target;
            }
        }
        return (int) totalSum;
    }
}
