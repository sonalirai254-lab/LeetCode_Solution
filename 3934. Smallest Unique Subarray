////////////////////////////////                          3934. Smallest Unique Subarray                        /////////////////////////////////









import java.util.*;

class Solution {
    public int smallestUniqueSubarray(int[] nums) {
        int n = nums.length;

        int[] sa = new int[n];
        int[] rank = nums.clone();
        int[] newRank = new int[n];

        for (int i = 0; i < n; i++) sa[i] = i;

        for (int k = 1; k < n; k *= 2) {
            final int len = k;
            final int[] rk = rank;

            Integer[] order = new Integer[n];
            for (int i = 0; i < n; i++) order[i] = i;

            Arrays.sort(order, (x, y) -> {
                if (rk[x] != rk[y])
                    return Integer.compare(rk[x], rk[y]);

                int rx = x + len < n ? rk[x + len] : -1;
                int ry = y + len < n ? rk[y + len] : -1;

                return Integer.compare(rx, ry);
            });

            for (int i = 0; i < n; i++)
                sa[i] = order[i];

            newRank[sa[0]] = 0;

            for (int i = 1; i < n; i++) {
                int x = sa[i - 1];
                int y = sa[i];

                boolean diff = rank[x] != rank[y] ||
                    (x + len < n ? rank[x + len] : -1) !=
                    (y + len < n ? rank[y + len] : -1);

                newRank[y] = newRank[x] + (diff ? 1 : 0);
            }

            int[] temp = rank;
            rank = newRank;
            newRank = temp;

            if (rank[sa[n - 1]] == n - 1) break;
        }

        int[] pos = new int[n];

        for (int i = 0; i < n; i++)
            pos[sa[i]] = i;

        int[] lcp = new int[n];
        int h = 0;

        for (int i = 0; i < n; i++) {
            int r = pos[i];

            if (r == 0) {
                h = 0;
                continue;
            }

            int j = sa[r - 1];

            while (i + h < n && j + h < n &&
                   nums[i + h] == nums[j + h]) {
                h++;
            }

            lcp[r] = h;

            if (h > 0) h--;
        }

        int ans = n;

        for (int i = 0; i < n; i++) {
            int maxLcp = lcp[i];

            if (i + 1 < n)
                maxLcp = Math.max(maxLcp, lcp[i + 1]);

            int required = maxLcp + 1;

            if (required <= n - sa[i])
                ans = Math.min(ans, required);
        }

        return ans;
    }
}
