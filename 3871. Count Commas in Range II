///////////////////////////                       3871. Count Commas in Range II                            /////////////////////////////





class Solution {
    public long countCommas(long n) {
        long ans = 0;

      
        if (n >= 1000) {
            long count = Math.min(n, 999999L) - 1000 + 1;
            ans += count;
        }

        if (n >= 1000000L) {
            long count = Math.min(n, 999999999L) - 1000000L + 1;
            ans += count * 2;
        }

     
        if (n >= 1000000000L) {
            long count = Math.min(n, 999999999999L)
                       - 1000000000L + 1;
            ans += count * 3;
        }

     
        if (n >= 1000000000000L) {
            long count = Math.min(n, 999999999999999L)
                       - 1000000000000L + 1;
            ans += count * 4;
        }

        if (n >= 1000000000000000L) {
            ans += (n - 1000000000000000L + 1) * 5;
        }

        return ans;
    }
}
