/////           3699. Number of ZigZag Arrays I           //////




class Solution {
    static final int MOD = 1_000_000_007;

    public int zigZagArrays(int n, int l, int r) {
        int m = r - l + 1;

        long[] up = new long[m + 2];
        long[] down = new long[m + 2];
        long[] newUp = new long[m + 2];
        long[] newDown = new long[m + 2];
        long[] prefUp = new long[m + 2];
        long[] prefDown = new long[m + 2];

        for (int x = 1; x <= m; x++) {
            up[x] = x - 1;      
            down[x] = m - x;   
        }
        for (int len = 3; len <= n; len++) {
            prefUp[0] = 0;
            prefDown[0] = 0;

            for (int x = 1; x <= m; x++) {
                prefUp[x] = (prefUp[x - 1] + up[x]) % MOD;
                prefDown[x] = (prefDown[x - 1] + down[x]) % MOD;
            }

            long totalUp = prefUp[m];

            for (int x = 1; x <= m; x++) {
                
                newUp[x] = prefDown[x - 1];

        
                newDown[x] = (totalUp - prefUp[x] + MOD) % MOD;
            }

            for (int x = 1; x <= m; x++) {
                up[x] = newUp[x];
                down[x] = newDown[x];
            }
        }

        long ans = 0;
        for (int x = 1; x <= m; x++) {
            ans = (ans + up[x] + down[x]) % MOD;
        }

        return (int) ans;
    }
}
