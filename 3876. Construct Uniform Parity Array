///////////////////////                      3876. Construct Uniform Parity Array                     /////////////////////////







class Solution {
    public boolean uniformArray(int[] nums1) {
        int min = Integer.MAX_VALUE;

        for (int num : nums1) {
            min = Math.min(min, num);
        }

        for (int num : nums1) {
            if ((num - min) % 2 != 0) {
              
                continue;
            }
        }

        boolean hasOdd = false;
        boolean hasEven = false;

        for (int num : nums1) {
            if (num % 2 == 0)
                hasEven = true;
            else
                hasOdd = true;
        }

       
        if (!hasOdd || !hasEven) {
            return true;
        }

        if (min % 2 == 1) {
            return true;
        }

       
        int minOdd = Integer.MAX_VALUE;

        for (int num : nums1) {
            if (num % 2 == 1) {
                minOdd = Math.min(minOdd, num);
            }
        }

        return minOdd < min;
    }
}
