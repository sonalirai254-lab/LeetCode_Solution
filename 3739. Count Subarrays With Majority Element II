//////           3739. Count Subarrays With Majority Element II              //////




class Solution {
    public long countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;
        int offset = n + 2;
        int size = 2 * n + 5;
        int[] bit = new int[size];

        long ans = 0;
        int prefix = 0;

        add(bit, offset, 1);

        for (int x : nums) {
            if (x == target) {
                prefix++;
            } else {
                prefix--;
            }

            ans += query(bit, prefix + offset - 1);
            add(bit, prefix + offset, 1);
        }

        return ans;
    }

    private void add(int[] bit, int idx, int val) {
        while (idx < bit.length) {
            bit[idx] += val;
            idx += idx & -idx;
        }
    }

    private int query(int[] bit, int idx) {
        int sum = 0;
        while (idx > 0) {
            sum += bit[idx];
            idx -= idx & -idx;
        }
        return sum;
    }
}
