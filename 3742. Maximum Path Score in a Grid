////            3742. Maximum Path Score in a Grid           ////



class Solution {
    public int maxPathScore(int[][] grid, int k) {
        int m = grid.length, n = grid[0].length;
        int NEG = -1000000000;

        int[][][] dp = new int[m][n][k + 1];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int c = 0; c <= k; c++) {
                    dp[i][j][c] = NEG;
                }
            }
        }

        int startCost = cost(grid[0][0]);
        if (startCost > k) return -1;

        dp[0][0][startCost] = grid[0][0];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int c = 0; c <= k; c++) {
                    if (dp[i][j][c] == NEG) continue;

                    if (i + 1 < m) {
                        int nc = c + cost(grid[i + 1][j]);
                        if (nc <= k) {
                            dp[i + 1][j][nc] = Math.max(dp[i + 1][j][nc],
                                    dp[i][j][c] + grid[i + 1][j]);
                        }
                    }

                    if (j + 1 < n) {
                        int nc = c + cost(grid[i][j + 1]);
                        if (nc <= k) {
                            dp[i][j + 1][nc] = Math.max(dp[i][j + 1][nc],
                                    dp[i][j][c] + grid[i][j + 1]);
                        }
                    }
                }
            }
        }

        int ans = -1;
        for (int c = 0; c <= k; c++) {
            ans = Math.max(ans, dp[m - 1][n - 1][c]);
        }

        return ans;
    }

    private int cost(int val) {
        return val == 0 ? 0 : 1;
    }
}
