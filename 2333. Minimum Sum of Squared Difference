//////////////////////////////                     2333. Minimum Sum of Squared Difference                     ///////////////////////////////







class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        long k = (long) k1 + k2;
        int[] freq = new int[100001];
        int max = 0;

        for (int i = 0; i < nums1.length; i++) {
            int d = Math.abs(nums1[i] - nums2[i]);
            freq[d]++;
            max = Math.max(max, d);
        }

        for (int d = max; d > 0 && k > 0; d--) {
            if (freq[d] == 0) {
                continue;
            }

            int next = d - 1;
            long cost = (long) freq[d] * (d - next);

            if (k >= cost) {
                freq[next] += freq[d];
                k -= cost;
                freq[d] = 0;
            } else {
                long full = k / freq[d];
                int rem = (int) (k % freq[d]);

                freq[d] -= rem;
                freq[d - 1] += rem;

                if (full > 0) {
                    freq[d] += rem;
                }

               
                int count = freq[d];
                freq[d] -= count;
                freq[d - (int) full] += count;
                k = 0;
            }
        }

        long ans = 0;
        for (int d = 1; d <= 100000; d++) {
            ans += (long) d * d * freq[d];
        }

        return ans;
    }
}
