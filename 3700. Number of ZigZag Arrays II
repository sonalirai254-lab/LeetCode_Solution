/////            3700. Number of ZigZag Arrays II            //////



class Solution {
    static final long MOD = 1_000_000_007L;

    public int zigZagArrays(int n, int l, int r) {
        int m = r - l + 1;

        if (n == 1) return m;
        if (n == 2) return (int) ((1L * m * (m - 1)) % MOD);

        int size = 2 * m; 

        long[][] T = new long[size][size];


        for (int x = 0; x < m; x++) {
            for (int y = 0; y < x; y++) {
                T[x][m + y] = 1;
            }
        }


        for (int x = 0; x < m; x++) {
            for (int y = x + 1; y < m; y++) {
                T[m + x][y] = 1;
            }
        }

        long[] base = new long[size];
        for (int x = 0; x < m; x++) {
            base[x] = x;           
            base[m + x] = m - 1 - x; 
        }


        long[][] P = matPow(T, n - 2);

    
        long[] res = multiply(P, base);

        long ans = 0;
        for (long val : res) {
            ans = (ans + val) % MOD;
        }

        return (int) ans;
    }

    private long[][] matMul(long[][] A, long[][] B) {
        int n = A.length;
        int m = B[0].length;
        int k = B.length;

        long[][] C = new long[n][m];

        for (int i = 0; i < n; i++) {
            for (int x = 0; x < k; x++) {
                if (A[i][x] == 0) continue;
                long a = A[i][x];
                for (int j = 0; j < m; j++) {
                    if (B[x][j] == 0) continue;
                    C[i][j] = (C[i][j] + a * B[x][j]) % MOD;
                }
            }
        }
        return C;
    }

    private long[] multiply(long[][] A, long[] v) {
        int n = A.length;
        int m = v.length;
        long[] res = new long[n];

        for (int i = 0; i < n; i++) {
            long sum = 0;
            for (int j = 0; j < m; j++) {
                if (A[i][j] == 0) continue;
                sum = (sum + A[i][j] * v[j]) % MOD;
            }
            res[i] = sum;
        }
        return res;
    }

    private long[][] matPow(long[][] base, int exp) {
        int n = base.length;
        long[][] result = new long[n][n];

    
        for (int i = 0; i < n; i++) result[i][i] = 1;

        while (exp > 0) {
            if ((exp & 1) == 1) result = matMul(result, base);
            base = matMul(base, base);
            exp >>= 1;
        }
        return result;
    }
}
