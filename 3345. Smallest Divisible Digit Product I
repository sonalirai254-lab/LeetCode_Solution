/////////////                   3345. Smallest Divisible Digit Product I                  ///////////////




class Solution {
    public int smallestNumber(int n, int t) {
        while (true) {
            int product = digitProduct(n);

            if (product % t == 0) {
                return n;
            }

            n++;
        }
    }

    private int digitProduct(int number) {
        int product = 1;

        while (number > 0) {
            product *= number % 10;
            number /= 10;
        }

        return product;
    }
}
