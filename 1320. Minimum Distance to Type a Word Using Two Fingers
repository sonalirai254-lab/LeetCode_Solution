////         1320. Minimum Distance to Type a Word Using Two Fingers          ////



class Solution {
    public int minimumDistance(String word) {
        int n = word.length();
        int[][] dp = new int[27][27];
        int INF = 1000000000;
        
        for (int i = 0; i < 27; i++) {
            for (int j = 0; j < 27; j++) {
                dp[i][j] = INF;
            }
        }
        
        dp[26][26] = 0;
        
        for (char ch : word.toCharArray()) {
            int curr = ch - 'A';
            int[][] next = new int[27][27];
            
            for (int i = 0; i < 27; i++) {
                for (int j = 0; j < 27; j++) {
                    next[i][j] = INF;
                }
            }
            
            for (int left = 0; left < 27; left++) {
                for (int right = 0; right < 27; right++) {
                    if (dp[left][right] == INF) continue;
                    next[curr][right] = Math.min(
                        next[curr][right],
                        dp[left][right] + distance(left, curr)
                    );
                    next[left][curr] = Math.min(
                        next[left][curr],
                        dp[left][right] + distance(right, curr)
                    );
                }
            }
            
            dp = next;
        }
        
        int ans = INF;
        for (int i = 0; i < 27; i++) {
            for (int j = 0; j < 27; j++) {
                ans = Math.min(ans, dp[i][j]);
            }
        }
        
        return ans;
    }
    
    private int distance(int from, int to) {
        if (from == 26) return 0; 
        
        int x1 = from / 6, y1 = from % 6;
        int x2 = to / 6, y2 = to % 6;
        
        return Math.abs(x1 - x2) + Math.abs(y1 - y2);
    }
}
