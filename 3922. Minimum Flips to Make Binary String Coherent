////          3922. Minimum Flips to Make Binary String Coherent            ////



class Solution {
    public int minFlips(String s) {
        int INF = 1_000_000;
        int[][] dp = new int[3][3];

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                dp[i][j] = INF;
            }
        }

        dp[0][0] = 0;

        for (char ch : s.toCharArray()) {
            int[][] ndp = new int[3][3];

            for (int i = 0; i < 3; i++) {
                for (int j = 0; j < 3; j++) {
                    ndp[i][j] = INF;
                }
            }

            for (int a = 0; a < 3; a++) {
                for (int b = 0; b < 3; b++) {
                    if (dp[a][b] == INF) continue;

                    for (char c = '0'; c <= '1'; c++) {
                        int cost = (ch == c) ? 0 : 1;

                        int na = a;
                        int nb = b;
                        if (a == 0 && c == '0') na = 1;
                        else if (a == 1 && c == '1') na = 2;
                        else if (a == 2 && c == '1') continue;
                        if (b == 0 && c == '1') nb = 1;
                        else if (b == 1 && c == '1') nb = 2;
                        else if (b == 2 && c == '0') continue;

                        ndp[na][nb] = Math.min(ndp[na][nb], dp[a][b] + cost);
                    }
                }
            }

            dp = ndp;
        }

        int ans = INF;
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                ans = Math.min(ans, dp[i][j]);
            }
        }

        return ans;
    }
}
