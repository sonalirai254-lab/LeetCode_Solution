///////////////////////////                       3414. Maximum Score of Non-overlapping Intervals                       ////////////////////////////






import java.util.*;

class Solution {

    static class Interval {
        int l, r, w, idx;

        Interval(int l, int r, int w, int idx) {
            this.l = l;
            this.r = r;
            this.w = w;
            this.idx = idx;
        }
    }

    static class State {
        long score;
        List<Integer> list;

        State(long score, List<Integer> list) {
            this.score = score;
            this.list = list;
        }
    }

    public int[] maximumWeight(List<List<Integer>> intervals) {

        int n = intervals.size();

        Interval[] arr = new Interval[n];

        for (int i = 0; i < n; i++) {
            arr[i] = new Interval(
                intervals.get(i).get(0),
                intervals.get(i).get(1),
                intervals.get(i).get(2),
                i
            );
        }
        Arrays.sort(arr, (a, b) -> {
            if (a.r != b.r) {
                return Integer.compare(a.r, b.r);
            }
            return Integer.compare(a.l, b.l);
        });

        int[] prev = new int[n];

        for (int i = 0; i < n; i++) {
            prev[i] = findPrevious(arr, i);
        }

      
        State[][] dp = new State[n + 1][5];

        for (int i = 0; i <= n; i++) {
            for (int k = 0; k <= 4; k++) {
                dp[i][k] = new State(0, new ArrayList<>());
            }
        }

        for (int i = 1; i <= n; i++) {

            Interval cur = arr[i - 1];

            for (int k = 1; k <= 4; k++) {

                State notTake = dp[i - 1][k];

                int p = prev[i - 1] + 1;

                State previous = dp[p][k - 1];

                long takeScore = previous.score + cur.w;

                List<Integer> takeList =
                    new ArrayList<>(previous.list);

                takeList.add(cur.idx);
                Collections.sort(takeList);

                if (takeScore > notTake.score) {

                    dp[i][k] = new State(
                        takeScore,
                        takeList
                    );

                } else if (takeScore < notTake.score) {

                    dp[i][k] = new State(
                        notTake.score,
                        new ArrayList<>(notTake.list)
                    );

                } else {

                    if (lexicographicallySmaller(
                            takeList,
                            notTake.list)) {

                        dp[i][k] = new State(
                            takeScore,
                            takeList
                        );

                    } else {

                        dp[i][k] = new State(
                            notTake.score,
                            new ArrayList<>(notTake.list)
                        );
                    }
                }
            }
        }

        List<Integer> answer = dp[n][4].list;

        Collections.sort(answer);

        int[] result = new int[answer.size()];

        for (int i = 0; i < answer.size(); i++) {
            result[i] = answer.get(i);
        }

        return result;
    }

    static int findPrevious(Interval[] arr, int i) {

        int low = 0;
        int high = i - 1;
        int ans = -1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (arr[mid].r < arr[i].l) {
                ans = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return ans;
    }

    static boolean lexicographicallySmaller(
            List<Integer> a,
            List<Integer> b) {

        int n = Math.min(a.size(), b.size());

        for (int i = 0; i < n; i++) {

            if (!a.get(i).equals(b.get(i))) {
                return a.get(i) < b.get(i);
            }
        }

        return a.size() < b.size();
    }
}
