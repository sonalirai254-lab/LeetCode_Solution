////          3896. Minimum Operations to Transform Array into Alternating Prime           ////



class Solution {
    private boolean isPrime(int n) {
        if (n < 2) return false;
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) return false;
        }
        return true;
    }
    private int nextPrime(int n) {
        while (!isPrime(n)) {
            n++;
        }
        return n;
    }
    private int nextNonPrime(int n) {
        while (isPrime(n)) {
            n++;
        }
        return n;
    }

    public int minOperations(int[] nums) {
        int operations = 0;

        for (int i = 0; i < nums.length; i++) {
            int num = nums[i];

            if (i % 2 == 0) {
                if (!isPrime(num)) {
                    int target = nextPrime(num);
                    operations += (target - num);
                }
            } else {
                if (isPrime(num)) {
                    int target = nextNonPrime(num);
                    operations += (target - num);
                }
            }
        }

        return operations;
    }
}
